    "Hold a shortcut to see where windows will go, release it to move them, or press Escape to cancel. When off, windows move as soon as the shortcut is pressed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Tastaturkurzbefehl gedrückt, um zu sehen, wohin die Fenster verschoben werden, lass ihn los, um sie zu verschieben, oder drücke Esc zum Abbrechen. Wenn diese Option deaktiviert ist, werden die Fenster verschoben, sobald der Tastaturkurzbefehl gedrückt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a shortcut to see where windows will go, release it to move them, or press Escape to cancel. When off, windows move as soon as the shortcut is pressed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un atajo para ver adónde irán las ventanas, suéltalo para moverlas o pulsa Esc para cancelar. Si está desactivado, las ventanas se mueven en cuanto se pulsa el atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez un raccourci enfoncé pour voir où les fenêtres iront, relâchez-le pour les déplacer, ou appuyez sur Esc pour annuler. Lorsque cette option est désactivée, les fenêtres se déplacent dès que le raccourci est pressé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを押している間、ウインドウの移動先を表示します。キーを離すとウインドウが移動し、Esc キーを押すとキャンセルされます。オフのときは、ショートカットを押すとすぐにウインドウが移動します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um atalho pressionado para ver para onde as janelas irão, solte-o para movê-las ou pressione Esc para cancelar. Quando desativado, as janelas se movem assim que o atalho é pressionado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住快捷键可查看窗口将移到的位置，松开即可移动窗口，按下 Esc 键则取消。关闭后，按下快捷键时窗口会立即移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住快速鍵即可查看視窗將移至的位置，放開即可移動視窗，按下 Esc 則取消。關閉時，按下快速鍵後視窗會立即移動。"
          }
        }
      }
    },
    "How far a linked resize moves a divider, as a share of the screen. Between 0% and 50%." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit eine verknüpfte Größenänderung eine Trennlinie verschiebt, als Anteil am Bildschirm. Zwischen 0 % und 50 %."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far a linked resize moves a divider, as a share of the screen. Between 0% and 50%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distancia que recorre un divisor al redimensionar en grupo, como porcentaje de la pantalla. Entre 0 % y 50 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance dont un redimensionnement lié déplace un séparateur, en pourcentage de l'écran. Entre 0 % et 50 %."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連動リサイズで区切り線を動かす距離を、画面に対する割合で指定します。0% から 50% までの範囲です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quanto um redimensionamento vinculado move um divisor, como porcentagem da tela. Entre 0% e 50%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "联动调整时分隔线每次移动的距离，以屏幕尺寸的百分比表示。范围为 0% 到 50%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聯動調整時分隔線每次移動的距離，以螢幕尺寸的百分比表示。範圍為 0% 到 50%。"
          }
        }
      }
    },
