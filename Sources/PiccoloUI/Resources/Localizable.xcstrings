{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ cannot be a global shortcut: it needs ⌃, ⌥ or ⌘, or has to be a function key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann kein globaler Tastaturkurzbefehl sein: Er braucht ⌃, ⌥ oder ⌘ oder muss eine Funktionstaste sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cannot be a global shortcut: it needs ⌃, ⌥ or ⌘, or has to be a function key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede ser un atajo global: necesita ⌃, ⌥ o ⌘, o tiene que ser una tecla de función."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas être un raccourci global : il doit comporter ⌃, ⌥ ou ⌘, ou être une touche de fonction."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はグローバルショートカットに使用できません。⌃、⌥、⌘ のいずれかを含めるか、ファンクションキーにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pode ser um atalho global: precisa de ⌃, ⌥ ou ⌘, ou ser uma tecla de função."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能用作全局快捷键：需要包含 ⌃、⌥ 或 ⌘，或使用功能键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不能作為全域快速鍵：需要 ⌃、⌥ 或 ⌘，或必須是功能鍵。"
          }
        }
      }
    },
