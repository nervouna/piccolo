    "The current shortcuts will be replaced by the defaults. A copy of the config file is kept next to it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuellen Tastaturkurzbefehle werden durch die Standardwerte ersetzt. Eine Kopie der Konfigurationsdatei wird daneben aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current shortcuts will be replaced by the defaults. A copy of the config file is kept next to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los atajos actuales se sustituirán por los valores por omisión. Se guarda una copia del archivo de configuración junto a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis actuels seront remplacés par les valeurs par défaut. Une copie du fichier de configuration est conservée à côté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のショートカットはデフォルトに置き換えられます。設定ファイルのコピーが隣に保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os atalhos atuais serão substituídos pelos padrões. Uma cópia do arquivo de configuração é mantida ao lado dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前的快捷键将被默认快捷键替换，配置文件的一份副本会保存在它旁边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的快速鍵將被預設值取代，設定檔的一份副本會保存在它旁邊。"
          }
        }
      }
    },
